[Unit]
Description=NoMoreVibe independent Oracle recovery watchdog
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nomorevibe-watchdog/oracle_watchdog.py --config /etc/nomorevibe-watchdog/config.json
Restart=always
RestartSec=15
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nomorevibe-watchdog
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
