[Unit]
Description=NoMoreVibe X candidate collector (OCI osaka-smoke only)
Wants=network-online.target
After=network-online.target
ConditionHost=osaka-smoke

[Service]
Type=oneshot
User=nomorevibe-x
Group=nomorevibe-x
WorkingDirectory=/opt/nomorevibe-x/current
EnvironmentFile=/etc/nomorevibe-x.env
ExecStart=/usr/bin/node /opt/nomorevibe-x/current/x-collector.mjs
StateDirectory=nomorevibe-x
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=50%
TimeoutStartSec=60
Restart=no
