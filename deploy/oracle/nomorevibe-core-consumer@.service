# Template. The launcher exits78 unless release/runtime/TZ/budget/OCI identity/consumer preflight are all verified.
# 2026-11-15: a 10-minute DB outage left both consumers `failed` for hours (3 restarts in 300s, then start-limit).
# Exit 78 (release/identity/privilege/contract rejection) is never restarted. Exit 75 (the launcher's own 10-minute
# retry of a DB/IMDS that did not answer ran out) and a crashed worker restart without a start limit, with a delay
# that grows from 15s to 5min. systemd >= 254 (osaka-smoke: 255) for RestartSteps/RestartMaxDelaySec.
# The native recovery gateway pins this file's sha256 (config unitSha256): update both together.
[Unit]
Description=NoMoreVibe Oracle consumer %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=nomorevibe-core
Group=nomorevibe-core
Slice=nomorevibe-core.slice
WorkingDirectory=/opt/nomorevibe-core/current
EnvironmentFile=/etc/nomorevibe-core/consumer-%i.env
# Operational timestamps are timezone-less UTC. The launcher and the consumer preflight refuse any other zone.
Environment=TZ=UTC
Environment=HOME=/var/lib/nomorevibe-core/consumer-%i
Environment=WORKER_HEALTH_PATH=/run/nomorevibe-core/consumer-%i/worker-health.json
ExecStart=/usr/bin/python3 /opt/nomorevibe-core/current/deploy/oracle/launch.py --consumer=%i
StateDirectory=nomorevibe-core/consumer-%i
RuntimeDirectory=nomorevibe-core/consumer-%i
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
KillMode=mixed
TimeoutStopSec=60s
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15s
RestartSteps=5
RestartMaxDelaySec=5min

[Install]
WantedBy=multi-user.target
