# Independent producer template only. No DB call occurs while the launcher is unavailable.
SERVICE_INSTANCE_ID=
RELEASE_TAG=
PHYSICAL_HOST=oracle-osaka-smoke
# The runtime preflight and the scheduler canary accept only batch contract 1.
JOB_BATCH_VERSION=1
WORKER_ROLE=scheduler
DATABASE_URL=
DB_POOLER_MODE=pgbouncer
DB_POOL_MAX=
# Required JSON {"mode":"enabled","policy":...,"process":{"kind":"scheduler-parent",...}} for the scheduler/host/release.
HOST_DB_BUDGET=
# Host aggregate ledger stays inactive while HOST_BUDGET_ENFORCEMENT is absent (never set it empty). Enabling it
# (HOST_BUDGET_ENFORCEMENT={"mode":"enabled","pressure":...}) also requires HTTP_ORIGIN_PERMITS=1: the ledger renewal
# reads http_origin_control (SELECT only). This producer sends no HTTP.
HTTP_ORIGIN_PERMITS=0
# No model, GitHub, X, migration or administrator credential belongs in this file.
