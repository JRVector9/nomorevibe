# Format only. Root-managed0600 per-consumer file outside the release; never commit real values.
# No environment setting skips a launcher check. The unit fixes TZ=UTC; do not set TZ here.
# Must start with "<consumer>-consumer-" (for example agent-scan-consumer-oracle).
SERVICE_INSTANCE_ID=
RELEASE_TAG=
PHYSICAL_HOST=oracle-osaka-smoke
# The consumer's parent role (filled by install_units.py from deploy/oracle/launch.py CONSUMERS).
WORKER_ROLE=
# The consumer's own least-privilege principal (least-privilege.sql "consumer <name>" section), never a role principal.
DATABASE_URL=
DB_POOLER_MODE=pgbouncer
# Required measured per-process allocation under the separate host aggregate budget.
DB_POOL_MAX=
# Required JSON {"mode":"enabled","policy":{...,"consumers":["<consumer>"]},"process":{"kind":"role-parent","role":"<parent role>","consumer":"<consumer>",...}}.
HOST_DB_BUDGET=
# Default inactive; future participation requires the existing shared DB policy and all callers.
HTTP_ORIGIN_PERMITS=0
# The consumer's own opt-in switch and only its approved secrets (added with the consumer, for example AGENT_SCAN_CONSUMER_VERSION).
# Do not provide JOB_BATCH_VERSION, model/CLI, migration/admin/OCI credentials or ALLOW_PRIVATE_URLS.
