# Format only. Root-managed0600 per-role file outside the release; never commit real values.
# No environment setting enables this phase's launcher.
SERVICE_INSTANCE_ID=
RELEASE_TAG=
PHYSICAL_HOST=oracle-osaka-smoke
JOB_BATCH_VERSION=
WORKER_ROLE=
DATABASE_URL=
DB_POOLER_MODE=pgbouncer
# Required measured per-process allocation under the separate host aggregate budget.
DB_POOL_MAX=
# Required JSON {"mode":"enabled","policy":...,"process":{"kind":"role-parent",...}} for this exact role/host/release.
HOST_DB_BUDGET=
# Default inactive; future participation requires the existing shared DB policy and all callers.
HTTP_ORIGIN_PERMITS=0
# Model/CLI credentials: only the selected role's approved secret injection, never a shared dump.
# Do not provide migration/admin/OCI credentials or ALLOW_PRIVATE_URLS.
