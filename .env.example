# DB 연결 문자열
DATABASE_URL=postgres://nomorevibe:nomorevibe@localhost:55434/nomorevibe

# 사이트 정식 origin.
# 리버스 프록시 뒤에서는 req.url이 내부 호스트로 재구성되므로 반드시 설정한다.
# 미설정 시 등록 응답의 page_url·verify_endpoint와 install.sh/skill.md의 주소가 내부 origin이 된다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 어드민 차단 API(DELETE /api/admin/products/<slug>) 인증 토큰
ADMIN_TOKEN=change-me

# 신뢰하는 리버스 프록시 hop 수 — rate limit의 클라이언트 식별에 사용.
#   0 (기본) 프록시 없음 → X-Forwarded-For를 신뢰하지 않는다
#   1        프록시 1개 (Traefik 단독 등)
#   2        CDN + 프록시 (Cloudflare + Traefik 등)
# 잘못 설정하면 rate limit이 우회되거나(과소) 전 사용자가 한 버킷에 묶인다(과대).
TRUSTED_PROXY_HOPS=0

# 스케줄러가 POST /api/cron/<job> 을 호출할 때 쓰는 토큰.
# 미설정이면 cron 진입점이 항상 403을 반환한다 (실수로 열려 있는 것보다 낫다).
CRON_SECRET=change-me

# 수집한 제품의 카테고리 분류에 쓴다 (Claude API).
# 없으면 분류를 건너뛰고 토픽·설명 키워드 규칙으로 떨어진다 — 수집은 그대로 돈다.
ANTHROPIC_API_KEY=

# 수집기가 GitHub을 읽을 때 쓴다 (repo:public 범위면 충분).
# 없으면 시간당 60회라 검색·조회가 성립하지 않고, crawl-seed/crawl-fetch가 실패로 남는다.
#   gh auth token   또는   Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# 로컬 개발 전용 — localhost URL 등록을 허용하고 SSRF 가드를 끈다.
# 프로덕션에서는 절대 설정하지 말 것.
# ALLOW_PRIVATE_URLS=1

# ─── 어드민 인증 (GitHub OAuth) ───
# 세션 쿠키 서명용. 32자 이상이어야 하며, 짧으면 서명이 거부된다.
#   openssl rand -hex 32
AUTH_SECRET=change-me-to-64-hex-chars

# 어드민을 허용할 GitHub 로그인명 (쉼표 구분).
# 비어 있으면 아무도 어드민이 아니다 — 실수로 열려 있는 것보다 낫다.
ADMIN_GITHUB_LOGINS=

# GitHub OAuth 앱 (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: <SITE>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── 로컬 배포 (docker compose) ───
# compose는 .env를 읽는다. .env.local과 분리하는 이유: 그쪽에는 ALLOW_PRIVATE_URLS가 있어
# SSRF 가드가 꺼진다. 배포 형태 검증이 목적이므로 .env에는 절대 넣지 않는다.
#
#   cp .env.example .env
#   docker compose up -d --build   → http://localhost:3200
