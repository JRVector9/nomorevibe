# DB 연결 문자열
DATABASE_URL=postgres://nomorevibe:nomorevibe@localhost:55434/nomorevibe
# 직접 PostgreSQL이면 direct, PgBouncer를 통하면 pgbouncer. PgBouncer 모드는 지원하지 않는
# statement/lock timeout startup parameter를 보내지 않는다.
DB_POOLER_MODE=direct

# 사이트 정식 origin.
# 리버스 프록시 뒤에서는 req.url이 내부 호스트로 재구성되므로 반드시 설정한다.
# 미설정 시 등록 응답의 page_url·verify_endpoint와 install.sh/skill.md의 주소가 내부 origin이 된다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 두 Next.js 서버가 같은 Server Action payload와 release를 해석하도록 빌드 시 동일하게 주입한다.
# encryption key는 16/24/32 byte를 base64로 인코딩한 값이다.
#   openssl rand -base64 32
# Docker/Dokploy build에서는 build argument가 아니라 같은 이름의 build secret으로 전달한다.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
NEXT_DEPLOYMENT_ID=

# 운영센터가 같은 역할의 복제본을 구분할 때 쓰는 배포 단위 ID. 1~48자 영문/숫자/._-만 허용.
SERVICE_INSTANCE_ID=local-web

# 어드민 차단 API(DELETE /api/admin/products/<slug>) 인증 토큰
ADMIN_TOKEN=change-me

# 신뢰하는 리버스 프록시 hop 수 — rate limit의 클라이언트 식별에 사용.
#   0 (기본) 프록시 없음 → X-Forwarded-For를 신뢰하지 않는다
#   1        프록시 1개 (Traefik 단독 등)
#   2        CDN + 프록시 (Cloudflare + Traefik 등)
# 잘못 설정하면 rate limit이 우회되거나(과소) 전 사용자가 한 버킷에 묶인다(과대).
TRUSTED_PROXY_HOPS=0

# 호환 POST /api/cron/<job> 작업 접수 API에 쓰는 토큰. 독립 스케줄러는 DB를 직접 사용한다.
# 미설정이면 cron 진입점이 항상 403을 반환한다 (실수로 열려 있는 것보다 낫다).
CRON_SECRET=change-me

# 아웃바운드 방문자 쿠키를 제품별 HMAC으로 바꿀 때 쓰는 전용 키. 32자 이상이어야 한다.
# AUTH_SECRET, CRON_SECRET, edit-token 키와 재사용하지 않는다.
#   openssl rand -hex 32
VISITOR_HASH_SECRET=

# 제품 카테고리는 publisher의 Codex CLI가 10건씩 분류한다.
# ChatGPT Pro access token이면 Spark xhigh를 우선 사용하고, 실패하면 Terra high를 시도한다.
# API key는 Spark를 지원하지 않으므로 Terra 경로에 사용한다. 둘 다 실패하면 키워드 규칙으로 간다.
# codex-auth.sh가 로그인 후 원본 토큰을 워커 환경에서 제거한다.
CODEX_ACCESS_TOKEN=
OPENAI_API_KEY=

# AI 리뷰는 reviewer의 Claude CLI가 담당한다. 운영 서버에는 setup-token으로 만든 장기 토큰을 준다.
# worker CLI 2.1.263은 --safe-mode로 사용자 설정을 격리하면서 OAuth 인증을 보존한다.
# reviewer에만 주입한다. 로컬 단기 토큰 smoke와 운영 장기 인증은 별도로 확인한다.
CLAUDE_CODE_OAUTH_TOKEN=
# 신규 AI 리뷰용 모델. 최종 모델은 운영 검증 후 명시하며 빈 값에 임의 기본 모델을 넣지 않는다.
# 카테고리 분류에 사용 중인 코드의 모델 설정과 별개다.
CRAWL_REVIEW_MODEL=
# 모든 reviewer/publisher에 심사·발행 보호 릴리스를 적용하고 실제 모델 인증을 확인한 뒤 웹에 true를 주입한다.
# 이 값은 DB의 reviewMode를 바꾸지 않는다. /admin/review에서 사유와 함께 off→observe→enforce 전환.
# off는 AI 발행 보호 해제이므로 enforce 운영 장애 시 자동으로 낮추지 않는다.
CRAWL_REVIEW_READY=false
# 실행 파일이 PATH에 없을 때만 (기본 claude/codex)
# CLAUDE_CLI=
# CODEX_CLI=

# 수집기가 GitHub을 읽을 때 쓴다 (repo:public 범위면 충분).
# 없으면 시간당 60회라 검색·조회가 성립하지 않고, crawl-seed/crawl-fetch가 실패로 남는다.
#   gh auth token   또는   Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# 로컬 개발 전용 — localhost URL 등록을 허용하고 SSRF 가드를 끈다.
# 프로덕션에서는 절대 설정하지 말 것.
# ALLOW_PRIVATE_URLS=1

# ─── 어드민 인증 (GitHub OAuth) ───
# 세션 쿠키 서명용. 32자 이상이어야 하며, 짧으면 서명이 거부된다.
#   openssl rand -hex 32
AUTH_SECRET=change-me-to-64-hex-chars

# 어드민을 허용할 GitHub 로그인명 (쉼표 구분).
# 비어 있으면 아무도 어드민이 아니다 — 실수로 열려 있는 것보다 낫다.
ADMIN_GITHUB_LOGINS=

# 로컬 전용 — GitHub OAuth 없이 어드민에 들어간다. 운영에서는 절대 설정하지 말 것.
# ADMIN_LOCAL_LOGIN=1

# GitHub OAuth 앱 (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: <SITE>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── 로컬 배포 (docker compose) ───
# compose는 .env를 읽는다. .env.local과 분리하는 이유: 그쪽에는 ALLOW_PRIVATE_URLS가 있어
# SSRF 가드가 꺼진다. 배포 형태 검증이 목적이므로 .env에는 절대 넣지 않는다.
#
#   cp .env.example .env
#   docs/operations/independent-workers-runbook.md 의 release 순서를 사용한다.
# 웹은 http://localhost:3200, 로컬 배포 DB는 localhost:55437이다.
RELEASE_TAG=local

# 독립 실행 시 프로세스 역할. compose는 각 역할과 pool 상한을 명시한다.
# WORKER_ROLE=crawler
# DB_POOL_MAX=4
# 웹8+crawler4+reviewer3+publisher3+maintenance3+scheduler2+connect-agent1=24
# (release/관리 연결 별도). connect-agent는 WORKER_ROLE=connect-agent를 사용한다.
# 대기 취소는 postgres 3.4.9의 실행 계약에 맞춘다. 버전 변경 시 실제 DB 포화 검증이 필요하다.
# DB_POOL_WAIT_MS=5000
# DB_CONNECT_TIMEOUT_SECONDS=3
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_LOCK_TIMEOUT_MS=5000
# DB_MAX_LIFETIME_SECONDS=1800
# statement 기본 제한: 웹15000/scheduler10000/maintenance120000/기타60000(ms).

# 25초 작업 예산과 별개의 진행 불능 감시. HTTP/CLI 호출의 실제 상한을 측정 후 조정한다.
# 아래 env는 직접 실행에 적용된다. compose는 서비스별 값을 명시하므로 함께 수정한다.
# WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
# WORKER_PROGRESS_TIMEOUT_SECONDS=90
# WORKER_JOB_TIMEOUT_SECONDS=180
# WORKER_DRAIN_SECONDS=45
# Compose stop_grace_period=60s. supervisor는 leader에 SIGTERM 후 45초 drain,
# 필요 시 전체 자식 그룹 SIGKILL 및 최대 5초 정리를 수행한다. 변경 시 Compose 유예도 함께 조정한다.
# WORKER_HEALTH_PATH=/tmp/nomorevibe-worker-health.json

# Internal Codex owner. 운영에서는 AUTH_SECRET과 다른 값을 모든 web/publisher/connect-agent에
# 동일하게 주입한다. Never expose the agent port publicly.
# CONNECT_AGENT_URL=http://connect-agent:3020
# OPERATIONS_AGENT_SECRET=<at-least-32-characters>

# Optional local-only Codex connection. Requires ADMIN_LOCAL_LOGIN=1 and an HTTP loopback site URL.
# Bind the web port to 127.0.0.1; keep disabled for publicly reachable deployments.
ADMIN_LOCAL_CODEX=0
