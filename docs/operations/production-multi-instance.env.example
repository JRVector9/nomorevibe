# Shared web build/runtime values. Replace every bracketed value in the secret store.
DATABASE_URL=postgres://nomorevibe:<database-password>@100.99.209.55:6432/nomorevibe
DB_POOLER_MODE=pgbouncer
DB_POOL_MAX=6
WORKER_ROLE=web
NEXT_PUBLIC_SITE_URL=https://nomorevibe.brut.bot
NEXT_DEPLOYMENT_ID=<git-sha>
# Dokploy의 buildSecrets에도 같은 키/값으로 설정한다. buildArgs에 넣지 않는다.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<base64-32-byte-key>
RELEASE_TAG=<git-sha>
AUTH_SECRET=<64-hex-or-long-random-value>
VISITOR_HASH_SECRET=<different-64-hex-value>
OPERATIONS_AGENT_SECRET=<different-64-hex-value>
CONNECT_AGENT_URL=http://100.92.77.66:3020
ADMIN_GITHUB_LOGINS=JRVector9
GITHUB_OAUTH_CLIENT_ID=<github-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<github-oauth-client-secret>
CRON_SECRET=<different-random-value>
ADMIN_TOKEN=<different-random-value>
CRAWL_REVIEW_READY=false
TRUSTED_PROXY_HOPS=<measured-hop-count>
SERVICE_INSTANCE_ID=<m3-web-or-mini-web>

# Singleton worker overlay on M3. Use the same DATABASE_URL, DB_POOLER_MODE, release, and
# operations-agent values. Set one role and instance ID per application.
# connect-agent uses the Dockerfile connect-agent target, WORKER_ROLE=connect-agent, and DB_POOL_MAX=1.
GITHUB_TOKEN=<github-public-repository-token>
CLAUDE_CODE_OAUTH_TOKEN=<claude-setup-token>
CRAWL_REVIEW_MODEL=<verified-claude-model>
CODEX_ACCESS_TOKEN=<codex-access-token>
OPENAI_API_KEY=<optional-terra-fallback-key>

# The migration job alone uses the direct endpoint and exits after success.
MIGRATION_DATABASE_URL=postgres://nomorevibe:<database-password>@100.99.209.55:5432/nomorevibe
